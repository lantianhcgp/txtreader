<div class="container">
    <text class="info-bar">{{ title }}</text>
    <div class="content-row">
        <div class="side-btn" @click="goPrev">
            <text class="side-arrow">&#x3C;</text>
        </div>
        <text class="title">{{ text }}</text>
        <div class="side-btn" @click="goNext">
            <text class="side-arrow">&#x3E;</text>
        </div>
    </div>
    <div class="btn-row">
        <div class="btn" @click="goPrev">
            <text class="btn-label">Prev</text>
        </div>
        <div class="btn" @click="goNext">
            <text class="btn-label">Next</text>
        </div>
        <div class="btn" @click="resetPage">
            <text class="btn-label">Reset</text>
        </div>
    </div>
</div>
